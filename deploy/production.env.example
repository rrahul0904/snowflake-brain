# Vercel production configuration contract. Set secrets only in Vercel's
# encrypted Production environment; do not copy this file onto a laptop.
APP_BASE_URL=https://snowflakecertificationguide.vercel.app
AUTH_COOKIE_SECURE=true
FORCE_HTTPS=true
SECURITY_RATE_LIMIT_ENABLED=true

# PostgreSQL is mandatory. DATABASE_URL and DATABASE_MIGRATION_URL are secret
# store keys, not values that belong in a committed configuration file.
DATABASE_URL=SET_IN_VERCEL_SECRET_STORE_ONLY
# Migration jobs only; never configure this in the Vercel runtime. The job
# grants the runtime role schema usage plus table/sequence/function DML access.
DATABASE_MIGRATION_URL=SET_IN_APPROVED_DEPLOYMENT_JOB_ONLY
DATABASE_SCHEMA=public
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=6
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_MAX_IDLE_SECONDS=60
DB_POOL_MAX_LIFETIME_SECONDS=300
DB_POOL_RECONNECT_TIMEOUT_SECONDS=10

# Structured operations/alerting. Tokens and webhook URLs belong in the secret store.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_METRICS_TOKEN=REPLACE_ME
OBSERVABILITY_ERROR_WEBHOOK_URL=https://telemetry.example.com/errors
OBSERVABILITY_ALERT_WEBHOOK_URL=https://telemetry.example.com/alerts
OBSERVABILITY_WINDOW_SECONDS=300
OBSERVABILITY_5XX_ALERT_THRESHOLD=5
OBSERVABILITY_AUTH_FAILURE_ALERT_THRESHOLD=10
OBSERVABILITY_ALERT_COOLDOWN_SECONDS=300
OBSERVABILITY_MAX_LATENCY_SAMPLES=2000

# Private commercial bank is securely imported by an approved deployment job;
# production runtime serves only its active PostgreSQL release.
QUESTION_BANK_AUTO_IMPORT=false

# Account lifecycle email actions use the public HTTPS V26 account-action route.
ACCOUNT_EMAIL_DELIVERY_MODE=webhook
ACCOUNT_EMAIL_WEBHOOK_URL=https://mailer.example.com/account-actions
ACCOUNT_EMAIL_WEBHOOK_TOKEN=REPLACE_ME
ACCOUNT_EMAIL_ACTION_BASE_URL=https://snowflakecertificationguide.vercel.app
ACCOUNT_EMAIL_VERIFY_HOURS=24
ACCOUNT_PASSWORD_RESET_MINUTES=30
ACCOUNT_CHANGE_EMAIL_HOURS=2

# Google identity. Enable only after the exact callback URI is registered with
# the production Google OAuth client and its credentials are in the secret store.
GOOGLE_AUTH_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://snowflakecertificationguide.vercel.app/api/auth/google/callback

# Stripe billing (enable only after real price IDs/secrets are installed).
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_100=
STRIPE_PRICE_PREMIUM_250=
STRIPE_PRICE_PREMIUM_500=
STRIPE_PRICE_EXAM_PACK=
BILLING_PAST_DUE_GRACE_DAYS=3

# Editorial affiliate resources only; display/programmatic advertising remains unsupported.
AFFILIATE_RESOURCES_ENABLED=false
AMAZON_ASSOCIATE_TAG=
