# Production account lifecycle delivery settings.
# Keep webhook credentials in the deployment secret store.
ACCOUNT_EMAIL_DELIVERY_MODE=webhook
ACCOUNT_EMAIL_WEBHOOK_URL=https://mailer.example/account-action
ACCOUNT_EMAIL_WEBHOOK_TOKEN=
ACCOUNT_EMAIL_ACTION_BASE_URL=https://guide.example/static/account-action.html
ACCOUNT_EMAIL_VERIFY_HOURS=24
ACCOUNT_PASSWORD_RESET_MINUTES=30
ACCOUNT_CHANGE_EMAIL_HOURS=2

# Development/CI only. This stores the action URL in the local DB so tests can
# inspect the token without sending email. Never use outbox mode in production.
# ACCOUNT_EMAIL_DELIVERY_MODE=outbox
