# Local application URL. Docker Compose publishes the app at localhost:8010.
# If you use ./scripts/dev.sh directly on port 8000, use http://127.0.0.1:8000
# consistently for APP_BASE_URL, GOOGLE_OIDC_REDIRECT_URI and account links.
APP_BASE_URL=http://localhost:8010
AUTH_COOKIE_SECURE=false
FORCE_HTTPS=false
SECURITY_RATE_LIMIT_ENABLED=true

# Production persistence. Leave DATABASE_URL empty to use the existing SQLite
# local/test backend. Docker Compose supplies a PostgreSQL URL by default.
DATABASE_URL=
DATABASE_SCHEMA=public
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=12
DB_POOL_TIMEOUT_SECONDS=10

# CI-only: one PostgreSQL schema per test process so the existing isolated test
# scripts can exercise a shared PostgreSQL service safely.
POSTGRES_TEST_ISOLATION=false
POSTGRES_TEST_SCHEMA_PREFIX=snowflake_ci

# Vendor-neutral structured observability. Keep the metrics token and webhook
# endpoints in the deployment secret store. Webhooks receive sanitized event
# metadata only; request bodies, cookies, credentials and answer selections are
# never forwarded.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_METRICS_TOKEN=
OBSERVABILITY_ERROR_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_WINDOW_SECONDS=300
OBSERVABILITY_5XX_ALERT_THRESHOLD=5
OBSERVABILITY_AUTH_FAILURE_ALERT_THRESHOLD=10
OBSERVABILITY_ALERT_COOLDOWN_SECONDS=300
OBSERVABILITY_MAX_LATENCY_SAMPLES=2000

# SQLite local fallback / source for one-time migration tooling.
BRAIN_DB=./data/snowflake_certification.sqlite

# Private commercial question bank. Mount this directory privately in production;
# do not commit bank JSON files to the repository or place them under frontend/.
PRIVATE_QUESTION_BANK_DIR=/private/question_bank
QUESTION_BANK_AUTO_IMPORT=false

# Candidate email verification and recovery. Outbox is safe for local development.
# Production must use webhook with a real mail delivery service and secret token.
ACCOUNT_EMAIL_DELIVERY_MODE=outbox
ACCOUNT_EMAIL_WEBHOOK_URL=
ACCOUNT_EMAIL_WEBHOOK_TOKEN=
ACCOUNT_EMAIL_ACTION_BASE_URL=http://localhost:8010
ACCOUNT_EMAIL_VERIFY_HOURS=24
ACCOUNT_PASSWORD_RESET_MINUTES=30
ACCOUNT_CHANGE_EMAIL_HOURS=2

# Google OpenID Connect. Keep real credentials in .env / your deployment secret store.
# To enable locally, register the exact redirect URI with the Google OAuth client,
# populate the client ID/secret below, and set GOOGLE_AUTH_ENABLED=true.
GOOGLE_AUTH_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8010/api/auth/google/callback

# Stripe hosted checkout/webhooks. Keep real keys and webhook secrets private.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_100=
STRIPE_PRICE_PREMIUM_250=
STRIPE_PRICE_PREMIUM_500=
STRIPE_PRICE_EXAM_PACK=
BILLING_PAST_DUE_GRACE_DAYS=3

# Editorial affiliate resources only. The product does not support display ads,
# ad networks, sponsored placements, pixels, or third-party advertising SDKs.
AFFILIATE_RESOURCES_ENABLED=false
AMAZON_ASSOCIATE_TAG=
