# Local/dev state and non-runtime assets
.venv/
__pycache__/
.pytest_cache/
.git/
.github/
beta-demo/
data/
docs/
tests/
scripts/
deploy/
Dockerfile
docker-compose*.yml
*.sqlite
*.sqlite3
*.db
*.log

# Never package private/local configuration or provider secrets
.env
.env.*
private_content/

# The immutable release manifest is generated during the Vercel build. Keep
# this one non-secret build helper available while every other scripts/ file
# remains excluded above.
!scripts/
!scripts/write_release_manifest.py
