{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowflake-brain.local/schema/solution.schema.json",
  "title": "Snowflake Certification Solution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "certification_id",
    "exam_code",
    "answer_key",
    "explanation",
    "reasoning",
    "distractor_analysis",
    "exam_trap",
    "sources",
    "as_of",
    "status"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 8},
    "certification_id": {"type": "string", "minLength": 2},
    "exam_code": {"type": "string", "minLength": 3},
    "answer_key": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "explanation": {"type": "string", "minLength": 20},
    "reasoning": {"type": "string", "minLength": 20},
    "distractor_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "why_wrong"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 3},
          "why_wrong": {"type": "string", "minLength": 5}
        }
      }
    },
    "exam_trap": {"type": "string", "minLength": 5},
    "code_example": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "url"],
        "properties": {
          "type": {"type": "string", "enum": ["official_exam_guide", "official_docs", "official_learning", "official_announcement"]},
          "title": {"type": "string", "minLength": 2},
          "url": {"type": "string", "format": "uri"},
          "section": {"type": ["string", "null"]}
        }
      }
    },
    "as_of": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["draft", "source_checked", "verified", "retired"]}
  }
}
